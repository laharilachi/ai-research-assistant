# ========================================================
# AI Research Assistant - Environment Configuration
# ========================================================

# Groq API Key (Preferred: fast and free tier available)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model Provider selection: "groq" or "openai"
# Leave empty to automatically detect based on available API key (prefers Groq)
LLM_PROVIDER=groq

# Model Names
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini

# Research Settings
MAX_SEARCH_RESULTS=6
MAX_CONTENT_CHARS=6000
